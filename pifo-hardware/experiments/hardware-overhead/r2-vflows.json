{
  "schema": "rio-hardware-overhead-v1",
  "name": "r2-vflows",
  "title": "RIO resource scaling with the vFlow namespace (PIFO excluded)",
  "output_dir": "experiment-results/hardware-overhead/r2-vflows",
  "hardware": {
    "num_engines": 5,
    "vflows": [
      32,
      64,
      128,
      256,
      512,
      1024
    ],
    "entries_per_pe": 1024,
    "priority_bits": 8,
    "pifo_backend": "external",
    "flow_namespace": "coupled-to-vpifo-ids"
  },
  "configurations": [
    "static",
    "dynamic"
  ],
  "platforms": [
    "quartus",
    "vivado"
  ],
  "clock_mhz": 100,
  "threads": 8,
  "vivado_directive": "RuntimeOptimized",
  "plot": {
    "dpi": 180
  },
  "vivado_capacity_policy": "allow_oversized_estimates",
  "scope": "rio-without-pifo",
  "quartus_initialization": "compact_mif"
}
