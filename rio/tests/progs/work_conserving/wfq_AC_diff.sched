classes A, C;

// Against [wfq_BACD], which normalizes to wfq[(A,2),(B,1),(C,3),(D,4)]:
// arms B and D retire, and the surviving arm C's weight moves 3 -> 7. C
// sits at index 2 before the retires and at index 1 after them, so this
// pair pins which frame the [ChangeMeta] is emitted in.
policy = wfq[(A, 2), (C, 7)];

return policy
